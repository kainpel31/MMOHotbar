<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">

  <moduleName>MMO Hotbar</moduleName>

  <!--
    Plugin, INI, translations and the hotbar HUD movie: always installed.

    There is deliberately no optional keycap step. The keycap art is SkyUI's / Untarnished
    UI's own, and their terms allow modifying it but not redistributing it, so it is neither
    tracked in this repository nor shipped here. The mod is fully functional without it:
    list rows simply show no key glyph. To add the glyphs, build a set from a UI mod you
    have installed and drop it in Data/Interface/STB_Keycaps.swf; see flash/README.md.
  -->
  <requiredInstallFiles>
    <folder source="core" destination="" priority="0"/>
  </requiredInstallFiles>

</config>
